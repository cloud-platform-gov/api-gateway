# Copy to .env for local use. All values are safe local defaults; no secrets belong here.
# Empty values are treated as unset.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Trust X-Forwarded-* headers only from these proxies.
# false (default) | true | <hop count> | comma-separated IPs/CIDRs (e.g. 10.0.0.0/16)
TRUST_PROXY=false

# Downstream services. Optional: an unset URL makes that route prefix return 503.
# Running the gateway on the host: use localhost.
# Running the gateway in Docker: use host.docker.internal or the Compose service name.
IDENTITY_SERVICE_URL=http://localhost:4001
SERVICE_CATALOG_URL=http://localhost:4002
REQUEST_SERVICE_URL=http://localhost:4003

# In-memory rate limit per client IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Upstream timeouts (ms). UPSTREAM_TIMEOUT_MS applies to both response headers and body.
UPSTREAM_CONNECT_TIMEOUT_MS=2000
UPSTREAM_TIMEOUT_MS=10000
